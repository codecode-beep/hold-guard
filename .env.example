# Copy this file to .env and fill in your own values. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Webhook ID from the same app's Webhooks section (needs a public URL, e.g. your Render site)
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE=https://api-m.sandbox.paypal.com

# Claude (console.anthropic.com > API keys)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Where this app is reachable. Local: http://localhost:8000  Render: https://<your-app>.onrender.com
APP_BASE_URL=http://localhost:8000
SELLER_NAME=Demo Seller
DB_PATH=holdguard.db

# Optional: email alerts for high-risk sales.
# Gmail: turn on 2-Step Verification, then create an "App password" at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL=
ALERT_LEVELS=high
